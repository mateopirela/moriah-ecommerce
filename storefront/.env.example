# ============================================================
# MORIAH Café — Hydrogen environment variables
# Copy to `.env` and fill in with your Shopify store values.
# Never commit the real `.env` (it is gitignored).
# ============================================================

# --- Session ---
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Shopify Storefront API (cafemoriah) -------------------
# Easiest way to fill these: run `npx shopify hydrogen link`
# then `npx shopify hydrogen env pull`. These get injected
# automatically on Oxygen in production.
PUBLIC_STORE_DOMAIN="cafemoriah.myshopify.com"
PUBLIC_STOREFRONT_ID=""
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_CHECKOUT_DOMAIN="cafemoriah.myshopify.com"

# --- Customer Account API (optional, for login/accounts) ---
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# --- Analytics / tracking (optional) -----------------------
# Leave empty to disable. When set, GA4 + Meta Pixel are loaded
# and wired to Hydrogen's funnel events (view_item, add_to_cart,
# begin_checkout, purchase). CAPI for Meta is enabled by Shopify
# when you connect the Meta sales channel in admin.
PUBLIC_GA4_ID=""          # e.g. G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=""   # e.g. 1234567890
