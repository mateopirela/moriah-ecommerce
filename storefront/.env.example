# ============================================================
# MORIAH Café — variables de entorno
# Copia a `.env` y completa. Nunca subas el `.env` real (está gitignored).
# ============================================================

# --- Sesión / carrito (cookie firmada) ---------------------
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL pública del sitio (redirecciones de Wompi, sitemap, emails)
PUBLIC_SITE_URL="https://moriah-ecommerce-three.vercel.app"

# --- Wompi (Bancolombia) ------------------------------------
# Panel → Desarrolladores. Usa llaves pub_test_/prv_test_ para pruebas y
# pub_prod_/prv_prod_ en producción; el entorno se detecta por el prefijo.
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# --- Base de datos (Postgres) --------------------------------
# Producción: cadena de conexión Postgres (cualquier proveedor).
# Vacío en desarrollo = PGlite embebido en ./.data (no sirve en producción).
DATABASE_URL=""

# --- Job de cobros recurrentes (Vercel Cron) -----------------
# Vercel envía `Authorization: Bearer <CRON_SECRET>` al invocar /api/cron/subscriptions
CRON_SECRET=""

# --- Klaviyo (opcional: emails transaccionales y comunidad) --
KLAVIYO_PRIVATE_KEY=""
KLAVIYO_COMMUNITY_LIST_ID=""

# --- Analytics (opcional) -----------------------------------
PUBLIC_GA4_ID=""          # e.g. G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=""   # e.g. 1234567890
